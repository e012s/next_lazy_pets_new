{
  "name": "lazy_pets_new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4317",
    "build": "next build",
    "build:cap": "node scripts/build-capacitor-static.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "cf:ci": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "sync:f7-icons": "mkdir -p public/fonts && cp node_modules/framework7-icons/fonts/Framework7Icons-Regular.woff2 node_modules/framework7-icons/fonts/Framework7Icons-Regular.woff node_modules/framework7-icons/fonts/Framework7Icons-Regular.ttf public/fonts/",
    "assets:generate": "capacitor-assets generate --assetPath public/assets"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/device": "^7.0.5",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@opennextjs/cloudflare": "^1.20.17",
    "axios": "^1.21.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swiper": "^14.3.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.0",
    "@capacitor/ios": "^7.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "framework7-icons": "^5.0.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}
